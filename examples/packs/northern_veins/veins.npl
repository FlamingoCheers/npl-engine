npl@0.2
// ============================================================
// 北境灵脉 · 题材包（genre pack 示例）
// 复用方式：故事程序首行 import "veins.npl"（相对本文件目录），
// 即获得本包的世界事实 / 实体 / 进程；人物、场景、文风由故事自定。
// 题材包只装"世界的物理与历史"，不装"谁在 story 里"。
// ============================================================

world 北境 {
    // ---- 灵脉状态（运行时由 sets/clears 驱动）----
    fact 灵脉不稳 = false
    fact 灵脉裂痕已现 = false
    fact 灵脉外泄灵气 = false
    fact 灵脉坍塌 = false

    // ---- 题材常数（设定知识，通常不变）----
    fact 龙炎可融城墙 = true // 龙裔的吐息可熔化城墙
    fact 灵脉滋养法术 = true // 距灵脉越近，法术越强

    entity 灵脉 {
        desc = "城下地脉，北境一切灵气之源"
    }
    entity 龙裔祭司团 {
        desc = "世代守护灵脉的古老团契，通晓压止外泄的祭礼"
    }

    // ---- 世界进程：灵脉之死（乱序发生会被 simulate 告警）----
    process 灵脉坍塌 { // 城基之下的缓慢灾变
        stage 不稳 {
            fact = 灵脉不稳 // 老树无风自摇，井水变味
        }
        stage 裂痕 {
            fact = 灵脉裂痕已现 // 集市石板开裂，缝隙渗出微光
        }
        stage 外泄 {
            fact = 灵脉外泄灵气 // 夜里能听见地下的风声
        }
        stage 坍塌 {
            fact = 灵脉坍塌 // 城门楼下沉三尺
        }
    }
}
